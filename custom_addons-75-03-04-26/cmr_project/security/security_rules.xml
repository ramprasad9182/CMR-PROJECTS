<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Define your custom group -->
    <record id="group_custom_project_access" model="res.groups">
        <field name="name">Custom Project Access</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Apply the group to the Project main menu -->
    <record id="project.menu_project_management_all_tasks" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('cmr_project.group_custom_project_access')])]"/>
    </record>

    <record id="group_see_all_stages" model="res.groups">
        <field name="name">See All Project Stages</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- STEP 1: Create a new group category -->
    <record id="module_category_custom_task_visibility" model="ir.module.category">
        <field name="name">Task Visibility Control</field>
        <field name="description">Access control for project tasks based on user group</field>
        <field name="sequence">20</field>
    </record>

    <!-- STEP 2: Create a group inside the above category -->
    <record id="group_task_all_visible" model="res.groups">
        <field name="name">Can See All Tasks</field>
        <field name="category_id" ref="cmr_project.module_category_custom_task_visibility"/>
    </record>

       <!-- STEP 3: Rule for users NOT in the group -->
    <record id="project_task_visibility_rule_limited" model="ir.rule">
        <field name="name">Task Visible If Assigned (for non-group users)</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
        <!-- Apply to all internal users -->
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- STEP 4: Rule for users IN the group -->
    <record id="project_task_visibility_rule_all" model="ir.rule">
        <field name="name">All Tasks Visible (for group)</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Always True -->
        <field name="groups" eval="[(4, ref('cmr_project.group_task_all_visible'))]"/>
    </record>

</odoo>
