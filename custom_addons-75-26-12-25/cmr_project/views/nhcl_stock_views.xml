<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cmr_project_view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.view.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="security_check" required="picking_type_code == 'incoming' and purchase_id"
                       invisible="picking_type_code != 'incoming'" readonly="state == 'done'"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="before">
                <field name="project_id" domain="[('stage_id.name', '!=', 'Canceled')]"/>
            </xpath>

            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="bill_reference" readonly="state == 'done'"/>
            </xpath>

            <xpath expr="/form/sheet/notebook/page/field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="after">
                <field name="analytic_precision" column_invisible="1"/>
                <field name="analytic" widget="analytic_distribution"
                       attrs="{'readonly': [('purchase_line_id', '!=', False), ('sale_line_id', '!=', False)]}"/>
                <field name="stock_on_project"/>
            </xpath>
             <xpath expr="/form/sheet/notebook/page/field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="before">
                <field name="s_no"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_id']"
                   position="attributes">

                <attribute name="domain">
                    [
                    "&amp;",
                    ("id", "in", allowed_product_ids),

                    "|",
                    "&amp;",
                    "|", ("company_id", "=", False),
                    ("company_id", "=", company_id),
                    ("company_id", "parent_of", company_id),

                    "&amp;",
                    "|", ("company_id", "=", False),
                    ("company_id", "parent_of", ""),
                    ("type", "=", "consu")
                    ]
                </attribute>

            </xpath>

        </field>
    </record>

    <record id="cmr_project_vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.view.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="grc_qty" invisible="picking_type_code != 'incoming'" readonly="state == 'done'"/>
            </xpath>
        </field>
    </record>


    <record id="view_move_line_tree_project_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.tree.project.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="project_id"/>
            </field>
        </field>
    </record>


    <record id="view_inherit_stock_location_form" model="ir.ui.view">
        <field name="name">stock.location.address</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Address Details">
                        <group>
                            <!-- Address block -->
                            <group string="Address">
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." required="1"/>
                                    <field name="street2" placeholder="Street 2..."/>
                                    <div class="o_row">
                                        <field name="city" placeholder="City" required="1" class="o_col-4"/>
                                        <field name="zip" placeholder="ZIP" required="1" class="o_col-4"/>
                                        <field name="state_id" placeholder="State" required="1" class="o_col-4"/>
                                    </div>
                                    <field name="country_id" placeholder="Country" required="1"/>
                                </div>
                            </group>

                            <!-- GST & PAN block -->
                            <group string="GST &amp; PAN">
                                <field name="l10n_in_gst_treatment" required="1"/>
                                <field name="l10n_in_gstin" required="1"/>
                                <field name="pan" required="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="view_stock_move_line_sno" model="ir.ui.view">
        <field name="name">stock.move.line.sno</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_id']" position="before">
                <field name="s_no"/>
            </xpath>

        </field>
    </record>


</odoo>
