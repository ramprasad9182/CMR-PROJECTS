<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_add_method_of_payment" model="ir.ui.view">
        <field name="name">account.payment.add.method.of.payment</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group//group[@name='group1']//label" position="before">
                <field name="payment_for" readonly="1" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="allocation_amount" invisible="1"/>
                <field name="payment_type" invisible="1"/>
               <field name="is_internal_transfer" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook colspan="4" invisible="payment_for not in ['multi_account','multi_payment']">

                    <page string="Payment Item">
                        <group>
                            <group>
                                <button type="object" string='Get Open Invoices' name="load_payment_lines"
                                        invisble="state == 'posted'"
                                        class="oe_highlight" colspan="2" invisible="state == 'posted'"/>
                            </group>
                            <group>
                                <button type="object" string='Remove Open Invoices' name="remove_lines"
                                        invisble="state == 'posted'"
                                        class="oe_highlight" colspan="2" invisible="state == 'posted'"/>
                            </group>
                        </group>
                        <field name="dev_invoice_line_ids" nolabel="1"
                               invisible="payment_for != 'multi_payment'" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="invoice_id"/>
                                <field name="account_id"/>
                                <field name="date"/>
                                <field name="due_date"/>
                                <field name="original_amount"/>
                                <field name="balance_amount"/>
                                <field name="full_reconcile"/>
                                <field name="allocation"/>
                                <field name="diff_amt"/>
                                <field name="currency_id"/>
                            </list>
                        </field>
                        <group name="amount_summary" col="6" class="mt-2 mt-md-0">
                            <group colspan="4">
                            </group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="allocation_amount">
                                <field name="total_original_amount" readonly="1"/>
                                <field name="total_balance_amount" readonly="1"/>
                                <field name="allocation_amount" string="Total Allocation Amount" readonly="1"/>
                                <field name="total_remaining_amount" readonly="1"/>
                                <field name="excess_amount" readonly="1"/>
                            </group>
                            <div class="clearfix"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
