<odoo>
    <data>
        <record id="customer_invoice_stock_move_view" model="ir.ui.view">
            <field name="name">Move Name</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_stock_transfer" string="Deliver" type="object" class="oe_highlight"
                            invisible="state != 'posted' or move_type not in ['out_invoice','in_refund']
                            or picking_count &gt; 0 or sale_order_count &gt; 0 or picking_deliver == False"/>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="picking_type_id"
                           invisible="move_type not in ['in_invoice', 'out_refund','in_refund','out_invoice']"
                           readonly="1"/>
                    <field name="picking_transfer_id" invisible="1"/>
                    <field name="invoice_picking_id" invisible="1"/>
                    <field name="picking_deliver" invisible="1"/>
                    <field name="deliver_no" invisible="1"/>
                    <field name="deliver_status" invisible="1"/>
                    <field name="purchase_order_count" invisible="1"/>
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="attributes">
                    <attribute name="invisible">picking_count &gt; 0</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                    <field name="readonly_product_quantity" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
                    <attribute name="readonly">readonly_product_quantity == True</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="attributes">
                    <attribute name="readonly">readonly_product_quantity == True</attribute>
                </xpath>
                <xpath expr="//div[@class='oe_button_box']" position="inside">
                    <button type="object"
                            name="action_view_picking_delivery"
                            invisible="state != 'posted' or move_type not in ['out_invoice','in_refund'] or picking_count == 0"
                            class="oe_stat_button"
                            icon="fa-truck">
                        <field name="picking_count" string="Delivery" widget="statinfo"/>
                    </button>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_stock_receive" string="Receive" class="oe_highlight"
                            type="object"
                            invisible="state != 'posted' or move_type not in ['in_invoice','out_refund']
                            or picking_count &gt; 0 or purchase_order_count &gt; 0 or picking_deliver_bill == False"/>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="invoice_picking_id" invisible="1"/>
                    <field name="picking_deliver_bill" invisible="1"/>
                    <field name="deliver_no" invisible="1"/>
                    <field name="shipment_status" invisible="1"/>
                </xpath>
                <xpath expr="//div[@class='oe_button_box']" position="inside">
                    <button type="object"
                            name="action_view_picking_shipment"
                            invisible="state != 'posted' or move_type not in ['in_invoice','out_refund'] or picking_count == 0"
                            class="oe_stat_button"
                            icon="fa-truck">
                        <field name="picking_shipment_count" string="Shipment" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>