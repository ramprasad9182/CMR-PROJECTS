<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="view_users_form_inherit" model="ir.ui.view">
			<field name="model">res.users</field>
			<field name="inherit_id" ref="base.view_users_form" />
			<field name="arch" type="xml">
				<xpath expr="//page[@name='access_rights']"
					position="after">
					<page name="access_token" string="Access Token">
						<field name="token_ids">
							<list create="false" editable="bottom" delete="false">
								<field name="user_id" readonly="1"/>
								<field name="token" readonly="1"/>
								<field name="last_request" readonly="1"/>
								<field name="expires" readonly="1"/>
								<field name="is_expired"/>
							</list>
						</field>
					</page>
				</xpath>
			</field>
		</record>
	</data>
</odoo>