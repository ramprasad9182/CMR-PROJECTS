    <record id="ppts_tally_fields_in_account_payment_views" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="check_date"/>
<!--                attrs="{'readonly': [('state', '!=', 'draft')]}"-->
            </xpath>
            <xpath expr="//group" position="after">
                <group groups="ppts_tally_integration.group_user">
                    <group string="Tally - Odoo">
                        <field name="tally_payment_id" readonly="1"/>
                        <field name="tally_payment_name" readonly="1"/>
                    </group>
                    <group groups="ppts_tally_integration.group_manager">
                    </group>
                </group>
            </xpath>
        </field>
    </record>
