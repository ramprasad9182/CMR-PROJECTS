<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record model="ir.module.category" id="tally_module_management">
        <field name="name">Tally Module access</field>
        <field name="description">User access level for this module</field>
        <field name="sequence">3</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
        <field name="category_id" ref="ppts_tally_integration.tally_module_management"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('ppts_tally_integration.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
        <field name="category_id" ref="ppts_tally_integration.tally_module_management"/>
    </record>
    </data>
</odoo>
