    <!--Tally Entries-->
    <record id="tally_entries_view_form" model="ir.ui.view">
        <field name="name">tally.entries.form</field>
        <field name="model">tally.entries</field>
        <field name="arch" type="xml">
            <form string="Tally Entries" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="received_date"/>
                            <field name="tally_entry_type"/>
                        </group>
                        <group>
                            <field name="number_of_entries"/>
                        </group>
                    </group>
                    <separator string="Tally Entries"/>
                    <field name="tally_data" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list View -->
    <record id="tally_entries_view_list" model="ir.ui.view">
        <field name="name">tally.entries.list</field>
        <field name="model">tally.entries</field>
        <field name="arch" type="xml">
            <list string="Tally Entries" create="false" edit="false" delete="false">
                <field name="received_date"/>
                <field name="tally_entry_type"/>
                <field name="number_of_entries"/>
            </list>
        </field>
    </record>

    <record id="tally_entries_view_action" model="ir.actions.act_window">
        <field name="name">Tally Entries</field>
        <field name="res_model">tally.entries</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="ppts_tally_integration_log.tally_entries_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tally Entries before creating record in Odoo.
            </p>
        </field>
    </record>

    <menuitem name="Tally Entries"
              id="tally_entries_menu_action"
              sequence="3"
              parent="ppts_tally_integration_log.menu_ppts_tally_log_menu"
              action="ppts_tally_integration_log.tally_entries_view_action"/>

    <!--Odoo Entries-->
    <record id="Odoo_entries_view_form" model="ir.ui.view">
        <field name="name">odoo.entries.form</field>
        <field name="model">odoo.entries</field>
        <field name="arch" type="xml">
            <form string="Odoo Entries" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="synchronize_date"/>
                            <field name="odoo_entry_type"/>
                        </group>
                        <group>
                            <field name="number_of_odoo_entries"/>
                        </group>
                    </group>
                    <separator string="Odoo Entries"/>
                    <field name="odoo_data" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list View -->
    <record id="odoo_entries_view_list" model="ir.ui.view">
        <field name="name">odoo.entries.list</field>
        <field name="model">odoo.entries</field>
        <field name="arch" type="xml">
            <list string="Odoo Entries" create="false" edit="false" delete="false">
                <field name="synchronize_date"/>
                <field name="odoo_entry_type"/>
                <field name="number_of_odoo_entries"/>
            </list>
        </field>
    </record>

    <record id="odoo_entries_view_action" model="ir.actions.act_window">
        <field name="name">Odoo Entries</field>
        <field name="res_model">odoo.entries</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="ppts_tally_integration_log.odoo_entries_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Odoo Entries before creating record in Tally.
            </p>
        </field>
    </record>

    <menuitem name="Odoo Entries"
              id="odoo_entries_menu_action"
              sequence="4"
              parent="ppts_tally_integration_log.menu_ppts_tally_log_menu"
              action="ppts_tally_integration_log.odoo_entries_view_action"/>
